[
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Display Options"
      },
      {
        "type": "toggle",
        "messageKey": "DisplaySeconds",
        "label": "Display Seconds",
        "defaultValue": false,
        "description": "Indicate the current second by bolding the appropriate mark in the bezel. Causes the display to update every second."
      },
      {
        "type": "toggle",
        "messageKey": "DisplayBattery",
        "label": "Display Battery",
        "defaultValue": true,
        "description": "Display the battery as a percentage, and by drawing a ring around the activity bars."
      },
      {
        "type": "toggle",
        "capabilities": ["HEALTH"],
        "messageKey": "DisplayHealth",
        "label": "Display Health",
        "defaultValue": true,
        "description": "Display health data. Active hours (top), Minutes of exercise (left), Steps taken (right)."
      },
      {
        "type": "toggle",
        "capabilities": ["COLOR"],
        "messageKey": "UseColor",
        "label": "Use Color",
        "defaultValue": true,
        "description": "Disable to remove all colors."
      }
    ]
  },
  {
